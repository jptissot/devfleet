# generated by `airlock init` — edit freely; `init --force` regenerates
FROM airlock-base:latest

USER root

# The harness. node is claude-code's dependency, not DevFleet's.
RUN dnf install -y nodejs npm && dnf clean all

RUN npm install -g @anthropic-ai/claude-code

# DevFleet's own toolchain. `make check` is the gate on every change to this
# repo, so a sandbox that cannot run it can be used to write code but never to
# verify it — which is the half that matters.
#
# ShellCheck and make come from Fedora. bats does not: the distro package trails
# the >= 1.12 the suite needs, and npm publishes bats-core under the name `bats`,
# so it comes from there. node is already present for the harness.
RUN dnf install -y ShellCheck make && dnf clean all
RUN npm install -g bats

USER agent
